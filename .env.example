# ==========================================
# Open Wispr - Environment Configuration
# ==========================================

# Free Hugging Face Inference API Token
# Get your free token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Default Hugging Face Whisper Model
HF_MODEL=openai/whisper-large-v3-turbo

# Optional: Groq Whisper API Key (Ultra-fast cloud inference)
GROQ_API_KEY=

# Optional: OpenAI API Key
OPENAI_API_KEY=
